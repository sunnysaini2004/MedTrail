PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
DB_NAME=meditrail
# Local MySQL may use DB_SSL=false. Production requires DB_SSL=true and a PEM CA certificate.
DB_SSL=false
DB_SSL_CA=
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
